# Streamlit Community Cloud 배포용 비밀 값 템플릿.
#
# 이 파일 자체는 예시일 뿐입니다. 실제 값은 두 곳 중 하나에만 넣으세요.
#   - 로컬 실행:  프로젝트 루트의 .env  (git 에 올라가지 않음)
#   - 클라우드:   앱 화면 우측 하단 Manage app → Settings → Secrets 에 붙여넣기
#
# 아래 내용을 그대로 복사해 값만 채워서 Secrets 칸에 넣으면 됩니다.
# secrets.toml 을 저장소에 커밋하지 마세요. .gitignore 에 이미 막아뒀습니다.

# 아래 두 값은 반드시 실제 값으로 바꾸세요.
# 특히 API 키에 한글이 남아 있으면 분석 단계에서
# "'ascii' codec can't encode characters" 오류가 납니다.
GEMINI_API_KEY = "AIzaSy..."
APP_PASSWORD = "PUT_YOUR_PASSWORD_HERE"

RESEARCH_MODEL = "gemini-3.5-flash"
ANALYSIS_MODEL = "gemini-3.6-flash"
WRITER_MODEL = "gemini-3.6-flash"

MAX_IMAGE_EDGE = "1280"
CACHE_ENABLED = "true"
